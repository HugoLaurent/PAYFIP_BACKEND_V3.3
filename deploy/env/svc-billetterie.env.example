# Copier en svc-billetterie.env sur le serveur (jamais commité).
# NODE_ENV, HOST, PORT, DB_HOST, DB_PORT, SVC_GESTION_BASE_URL,
# SVC_MAIL_BASE_URL, SELF_BASE_URL sont fixés directement dans
# deploy/docker-compose.yml — inutile (et sans effet) de les redéfinir ici.

TZ=UTC
LOG_LEVEL=info
APP_KEY=
APP_URL=http://svc-billetterie:3335

# Doit correspondre exactement à SVC_BILLETTERIE_USER/PASSWORD/DB de
# deploy/postgres/.env.
DB_USER=svc_billetterie
DB_PASSWORD=
DB_DATABASE=svc_billetterie

GATEWAY_JWT_PUBLIC_KEY=
GESTION_JWT_PUBLIC_KEY=

# Clé privée EdDSA fraîche pour la prod, pour les appels pair-à-pair vers
# svc-gestion/svc-mail. La clé publique va dans BILLETTERIE_JWT_PUBLIC_KEY
# de svc-gestion et svc-mail.
BILLETTERIE_JWT_PRIVATE_KEY=

# real : envoie de vrais emails OTP via svc-mail (cohérent avec la prod).
OTP_MODE=real

# Secret frais pour la prod (jamais dev-ticket-secret-change-me).
TICKET_SIGNING_SECRET=

# Clés partagées avec le vrai système AREGIE — coordination nécessaire
# avec AREGIE pour la rotation, ne pas réutiliser les clés dev.
AREGIE_API_KEYS=
