# Copier en svc-factures.env sur le serveur (jamais commité).
# NODE_ENV, HOST, PORT, DB_HOST, DB_PORT, SVC_GESTION_BASE_URL,
# SVC_AUTH_BASE_URL, SVC_MAIL_BASE_URL, SELF_BASE_URL sont fixés
# directement dans deploy/docker-compose.yml — inutile de les redéfinir ici.

TZ=UTC
LOG_LEVEL=info
APP_KEY=
APP_URL=http://svc-factures:3337

# Doit correspondre exactement à SVC_FACTURES_USER/PASSWORD/DB de
# deploy/postgres/.env.
DB_USER=svc_factures
DB_PASSWORD=
DB_DATABASE=svc_factures

GATEWAY_JWT_PUBLIC_KEY=
GESTION_JWT_PUBLIC_KEY=

# Clé privée EdDSA fraîche pour la prod. La clé publique va dans
# FACTURES_JWT_PUBLIC_KEY de svc-auth, svc-gestion et svc-mail.
FACTURES_JWT_PRIVATE_KEY=

# Clés partagées avec le vrai système AREGIE — coordination nécessaire
# avec AREGIE pour la rotation, ne pas réutiliser les clés dev.
AREGIE_API_KEYS=
