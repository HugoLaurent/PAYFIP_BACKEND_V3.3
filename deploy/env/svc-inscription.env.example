# Copier en svc-inscription.env sur le serveur (jamais commité).
# NODE_ENV, HOST, PORT, DB_HOST, DB_PORT, SVC_GESTION_BASE_URL,
# SVC_MAIL_BASE_URL, SVC_AUTH_BASE_URL, SELF_BASE_URL sont fixés
# directement dans deploy/docker-compose.yml — inutile (et sans effet) de
# les redéfinir ici.

TZ=UTC
LOG_LEVEL=info
APP_KEY=
APP_URL=http://svc-inscription:3341

# Doit correspondre exactement à SVC_INSCRIPTION_USER/PASSWORD/DB de
# deploy/postgres/.env.
DB_USER=svc_inscription
DB_PASSWORD=
DB_DATABASE=svc_inscription

GATEWAY_JWT_PUBLIC_KEY=
GESTION_JWT_PUBLIC_KEY=

# Clé privée EdDSA fraîche pour la prod, pour les appels pair-à-pair vers
# svc-gestion/svc-mail/svc-auth. La clé publique va dans
# INSCRIPTION_JWT_PUBLIC_KEY de svc-gestion, svc-mail et svc-auth.
# Génération (voir svc-billetterie/tests/helpers/internal_auth.ts pour le
# format attendu) :
#   node -e "const{generateKeyPair,exportJWK}=require('jose');(async()=>{const{privateKey,publicKey}=await generateKeyPair('EdDSA');console.log('PRIVATE',Buffer.from(JSON.stringify(await exportJWK(privateKey))).toString('base64'));console.log('PUBLIC',Buffer.from(JSON.stringify(await exportJWK(publicKey))).toString('base64'))})()"
INSCRIPTION_JWT_PRIVATE_KEY=

# real : envoie de vrais emails OTP via svc-mail (cohérent avec la prod).
OTP_MODE=real
# Ne jamais définir en prod — filet de sécurité pour OTP_MODE=fake, voir
# start/env.ts.
ALLOW_INSECURE_OTP_MODE=

# Domaine public (pas l'URL interne docker) — pour les liens/images dans
# les emails transactionnels.
PAYFIP_PUBLIC_BASE_URL=https://lachetaloc.com

# Alerte Teams si un email échoue plus de 24h (voir ops_alert_service.ts).
OPS_ALERT_WEBHOOK_URL=
