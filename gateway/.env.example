# Node
TZ=UTC
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Clé privée EdDSA (JWK JSON encodé en base64) — le Gateway est le seul à
# la détenir. Générer avec le script de génération de clés (voir README).
GATEWAY_JWT_PRIVATE_KEY=

# Secret du JWT client (navigateur agent/admin) — distinct de l'interne
CLIENT_JWT_SECRET=

# Services internes
SVC_AUTH_BASE_URL=http://localhost:3334
SVC_GESTION_BASE_URL=http://localhost:3333
SVC_BILLETTERIE_BASE_URL=http://localhost:3335
SVC_FACTURES_BASE_URL=http://localhost:3337
SVC_MAIL_BASE_URL=http://localhost:3339

# SSO staff — Authentik (OIDC). Voir Directory > Applications > AregiePay
# dans l'admin Authentik pour ces valeurs (Client ID/Secret sur la page du
# provider, issuer = "OpenID Configuration Issuer").
AUTHENTIK_ISSUER=https://auth.aregie.com/application/o/aregie-pay/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:3000/staff/auth/callback
STAFF_FRONTEND_REDIRECT_URL=http://localhost:5173/staff/auth/complete
STAFF_JWT_SECRET=

# CORS — en dev, l'origine est toujours acceptée (voir config/cors.ts) ;
# cette valeur ne sert qu'en production. Liste séparée par des virgules.
GATEWAY_ALLOWED_ORIGINS=