# Node
TZ=UTC
PORT=3337
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database (surchargé par docker-compose.yml en conteneur)
DB_HOST=localhost
DB_PORT=5436
DB_USER=svc_factures
DB_PASSWORD=
DB_DATABASE=svc_factures

# Internal auth — EdDSA asymétrique (JWK JSON encodé en base64)
GATEWAY_JWT_PUBLIC_KEY=
GESTION_JWT_PUBLIC_KEY=
FACTURES_JWT_PRIVATE_KEY=

# Appel direct à svc-gestion (pas via le Gateway, appel interne pair à pair)
SVC_GESTION_BASE_URL=http://localhost:3333
# Appel direct à svc-auth (pair-à-pair) — résolution numcli -> organisme/service
SVC_AUTH_BASE_URL=http://localhost:3334
# Appel direct à svc-mail (pair-à-pair) — svc-mail détient seul les
# identifiants SMTP.
SVC_MAIL_BASE_URL=http://localhost:3339
# URL par laquelle svc-gestion peut nous rappeler (webhook de résolution)
SELF_BASE_URL=http://localhost:3337

# AREGIE : appelant externe qui dépose les factures et reprend les paiements.
# Une seule clé partagée — l'organisme est résolu par numcli à chaque ligne.
AREGIE_API_KEYS=

# OTP — "fake" tant qu'il n'y a pas de vrai envoi d'email
OTP_MODE=fake