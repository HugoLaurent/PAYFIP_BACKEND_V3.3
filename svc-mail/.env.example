# Node
TZ=UTC
PORT=3339
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

DB_HOST=localhost
DB_PORT=5437
DB_USER=svc_mail
DB_PASSWORD=
DB_DATABASE=svc_mail

# Internal auth — EdDSA asymétrique (JWK JSON encodé en base64). Seuls
# svc-billetterie et svc-factures parlent à svc-mail, en pair-à-pair.
BILLETTERIE_JWT_PUBLIC_KEY=
FACTURES_JWT_PUBLIC_KEY=
# Clé publique du Gateway, pour la seule route staff (historique des envois)
GATEWAY_JWT_PUBLIC_KEY=
# Clé privée de svc-mail — signe les appels sortants vers svc-auth (scope
# 'mail') pour lire la clé API AREGIE Mail propre à un service.
MAIL_JWT_PRIVATE_KEY=
SVC_AUTH_BASE_URL=http://localhost:3334

# Envoi — "fake" tant qu'on ne veut pas solliciter le vrai service AREGIE Mail
MAIL_MODE=fake
# Service AREGIE Mail (https://mail.aregie.com) — laisser vide pour garder
# la valeur par défaut (https://mail.aregie.com/api/send). La clé API par
# défaut, elle, ne se configure PAS ici : elle se saisit depuis le back
# office staff (Emails > Paramètres d'envoi) et vit chiffrée en base. La
# clé propre à un service se saisit depuis la page Services et vit côté
# svc-auth (table services).
AREGIE_MAIL_API_URL=
# Garde-fou dev — tous les emails partent vers cette adresse, jamais vers
# celle demandée par l'appelant. Ne JAMAIS définir en production.
MAIL_TEST_OVERRIDE_EMAIL=

# Suivi d'erreurs (GlitchTip self-hosted, compatible Sentry) — laisser vide
# en dev/local, le SDK reste inerte sans DSN.
GLITCHTIP_DSN=

# Webhook Teams (Workflows) — alerte envoyée quand un envoi abandonne après
# 24h d'échecs. Laisser vide pour désactiver.
OPS_ALERT_WEBHOOK_URL=