# Node
TZ=UTC
PORT=3341
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database (surchargé par docker-compose.yml en conteneur)
DB_HOST=localhost
DB_PORT=5438
DB_USER=svc_inscription
DB_PASSWORD=
DB_DATABASE=svc_inscription

# Internal auth — EdDSA asymétrique (JWK JSON encodé en base64)
GATEWAY_JWT_PUBLIC_KEY=
GESTION_JWT_PUBLIC_KEY=
INSCRIPTION_JWT_PRIVATE_KEY=

# Appel direct à svc-gestion (pas via le Gateway, appel interne pair à pair)
SVC_GESTION_BASE_URL=http://localhost:3333
# Appel direct à svc-mail (pair-à-pair)
SVC_MAIL_BASE_URL=http://localhost:3339
# Appel direct à svc-auth (pair-à-pair) — statut du service, logo
SVC_AUTH_BASE_URL=http://localhost:3334
# URL par laquelle svc-gestion peut nous rappeler (webhook de paiement)
SELF_BASE_URL=http://localhost:3341
# Domaine public du Gateway (logo de service embarqué dans les emails)
PAYFIP_PUBLIC_BASE_URL=http://localhost:3000

# OTP — "fake" tant qu'il n'y a pas de vrai envoi d'email. Nécessite aussi
# ALLOW_INSECURE_OTP_MODE ci-dessous (sinon le code n'est jamais renvoyé en
# clair dans la réponse, même avec OTP_MODE=fake) — à ne JAMAIS mettre en
# vraie prod.
OTP_MODE=fake
ALLOW_INSECURE_OTP_MODE=this-is-not-production

# Suivi d'erreurs (GlitchTip self-hosted, compatible Sentry) — laisser vide
# en dev/local, le SDK reste inerte sans DSN.
GLITCHTIP_DSN=

# Webhook Teams (Workflows) — alerte envoyée quand un email d'inscription
# abandonne après 24h d'échecs. Laisser vide pour désactiver.
OPS_ALERT_WEBHOOK_URL=
