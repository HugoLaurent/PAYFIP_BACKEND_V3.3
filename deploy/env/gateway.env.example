# Copier en gateway.env sur le serveur (jamais commité).
# NODE_ENV, HOST, PORT et les SVC_*_BASE_URL sont fixés directement dans
# deploy/docker-compose.yml — inutile (et sans effet) de les redéfinir ici.

TZ=UTC
LOG_LEVEL=info
APP_KEY=
APP_URL=https://lachetaloc.com

# Clé privée EdDSA fraîche pour la prod (jamais celle de dev). La clé
# publique correspondante va dans GATEWAY_JWT_PUBLIC_KEY de svc-auth,
# svc-billetterie, svc-factures, svc-gestion et svc-mail.
GATEWAY_JWT_PRIVATE_KEY=

# Secret frais pour la prod (jamais dev-client-secret-change-me).
CLIENT_JWT_SECRET=

# Secret frais pour la prod (jamais dev-staff-key-change-me).
STAFF_API_KEY=

# Origine(s) du front en prod, séparées par des virgules.
GATEWAY_ALLOWED_ORIGINS=
