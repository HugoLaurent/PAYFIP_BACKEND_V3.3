# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database (surchargé par docker-compose.yml en conteneur)
DB_HOST=localhost
DB_PORT=5432
DB_USER=svc_gestion
DB_PASSWORD=
DB_DATABASE=svc_gestion

# Internal auth — clés publiques EdDSA des émetteurs de confiance
GATEWAY_JWT_PUBLIC_KEY=
BILLETTERIE_JWT_PUBLIC_KEY=
FACTURES_JWT_PUBLIC_KEY=

# Origines autorisées pour frontRedirectUrl (séparées par des virgules)
FRONT_ALLOWED_ORIGINS=http://localhost:5173

# PayFiP — "fake" tant qu'on n'a pas les accès sandbox réels
PAYFIP_MODE=fake
# URL publique du Gateway (via ngrok/Cloudflare Tunnel en dev) — utilisée pour URLNOTIF/URLREDIRECT
PAYFIP_PUBLIC_BASE_URL=
# Adresse du service fake-payfip (simulateur, port 3336)
FAKE_PAYFIP_BASE_URL=
GESTION_JWT_PRIVATE_KEY=
SVC_AUTH_BASE_URL=

# Suivi d'erreurs (GlitchTip self-hosted, compatible Sentry) — laisser vide
# en dev/local, le SDK reste inerte sans DSN.
GLITCHTIP_DSN=

# Webhook Teams (Workflows) — alerte envoyée quand un webhook abandonne
# après 24h d'échecs. Laisser vide pour désactiver.
OPS_ALERT_WEBHOOK_URL=