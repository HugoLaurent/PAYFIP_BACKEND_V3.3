# Copier en .env sur le serveur (jamais commité) et remplacer tous les
# mots de passe par des valeurs générées (ex: openssl rand -base64 24).
# Ces valeurs doivent correspondre exactement à DB_USER/DB_PASSWORD/
# DB_DATABASE dans le .env de production de chaque service.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=

SVC_AUTH_USER=svc_auth
SVC_AUTH_PASSWORD=
SVC_AUTH_DB=svc_auth

SVC_BILLETTERIE_USER=svc_billetterie
SVC_BILLETTERIE_PASSWORD=
SVC_BILLETTERIE_DB=svc_billetterie

SVC_FACTURES_USER=svc_factures
SVC_FACTURES_PASSWORD=
SVC_FACTURES_DB=svc_factures

SVC_GESTION_USER=svc_gestion
SVC_GESTION_PASSWORD=
SVC_GESTION_DB=svc_gestion

SVC_MAIL_USER=svc_mail
SVC_MAIL_PASSWORD=
SVC_MAIL_DB=svc_mail
