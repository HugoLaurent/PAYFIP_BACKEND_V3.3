# Copier en svc-gestion.env sur le serveur (jamais commité).
# NODE_ENV, HOST, PORT, DB_HOST, DB_PORT, SVC_AUTH_BASE_URL sont fixés
# directement dans deploy/docker-compose.yml — inutile de les redéfinir ici.

TZ=UTC
LOG_LEVEL=info
APP_KEY=
APP_URL=http://svc-gestion:3333

# Doit correspondre exactement à SVC_GESTION_USER/PASSWORD/DB de
# deploy/postgres/.env.
DB_USER=svc_gestion
DB_PASSWORD=
DB_DATABASE=svc_gestion

GATEWAY_JWT_PUBLIC_KEY=
BILLETTERIE_JWT_PUBLIC_KEY=
FACTURES_JWT_PUBLIC_KEY=
INSCRIPTION_JWT_PUBLIC_KEY=

# Clé privée EdDSA fraîche pour la prod, pour signer les webhooks vers
# svc-billetterie/svc-factures. La clé publique va dans
# GESTION_JWT_PUBLIC_KEY de svc-auth, svc-billetterie et svc-factures.
GESTION_JWT_PRIVATE_KEY=

# Origine(s) du front en prod, séparées par des virgules (même valeur que
# GATEWAY_ALLOWED_ORIGINS du gateway).
FRONT_ALLOWED_ORIGINS=

# real : appelle le vrai PayFiP gouvernemental, plus le mock local.
PAYFIP_MODE=real

# URL publique par laquelle PayFiP nous rappelle (URLNOTIF/URLREDIRECT) —
# doit être le domaine public du gateway, qui proxy /paiement/payfip/*
# vers ce service. Remplace l'URL ngrok de dev.
PAYFIP_PUBLIC_BASE_URL=https://backfip.aregie.com

# Endpoint SOAP officiel PayFiP (production gouvernementale réelle).
PAYFIP_SOAP_URL=https://www.payfip.gouv.fr/tpa/services/securite
