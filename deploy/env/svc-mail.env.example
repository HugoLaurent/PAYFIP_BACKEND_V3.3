# Copier en svc-mail.env sur le serveur (jamais commité).
# NODE_ENV, HOST, PORT, DB_HOST, DB_PORT sont fixés directement dans
# deploy/docker-compose.yml — inutile de les redéfinir ici.
#
# IMPORTANT : ne JAMAIS définir MAIL_TEST_OVERRIDE_EMAIL ici — sinon tous
# les emails réels (OTP, confirmations) partent vers une adresse de dev
# au lieu du vrai destinataire.

TZ=UTC
LOG_LEVEL=info
APP_KEY=
APP_URL=http://svc-mail:3339

# Doit correspondre exactement à SVC_MAIL_USER/PASSWORD/DB de
# deploy/postgres/.env.
DB_USER=svc_mail
DB_PASSWORD=
DB_DATABASE=svc_mail

BILLETTERIE_JWT_PUBLIC_KEY=
FACTURES_JWT_PUBLIC_KEY=
GATEWAY_JWT_PUBLIC_KEY=
INSCRIPTION_JWT_PUBLIC_KEY=
# Signe les appels sortants vers svc-auth (lecture de la clé API AREGIE
# Mail propre à un service) — clé PRIVÉE, la publique correspondante va
# dans MAIL_JWT_PUBLIC_KEY côté svc-auth.
MAIL_JWT_PRIVATE_KEY=
SVC_AUTH_BASE_URL=http://svc-auth:3333

# real : envoi effectif via l'API AREGIE Mail (plus de SMTP direct).
MAIL_MODE=real

# Clé API AREGIE Mail "par défaut" (emails sans service, ex. OTP) — se
# saisit depuis le back office staff (Emails > Paramètres d'envoi), pas
# ici. La clé propre à un service se saisit depuis la page Services et
# vit côté svc-auth. Laisser vide pour garder l'URL par défaut
# (https://mail.aregie.com/api/send).
AREGIE_MAIL_API_URL=
