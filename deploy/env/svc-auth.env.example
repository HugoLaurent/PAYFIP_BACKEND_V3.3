# Copier en svc-auth.env sur le serveur (jamais commité).
# NODE_ENV, HOST, PORT, DB_HOST, DB_PORT sont fixés directement dans
# deploy/docker-compose.yml — inutile (et sans effet) de les redéfinir ici.

TZ=UTC
LOG_LEVEL=info
APP_KEY=
APP_URL=http://svc-auth:3334

# Doit correspondre exactement à SVC_AUTH_USER/PASSWORD/DB de
# deploy/postgres/.env.
DB_USER=svc_auth
DB_PASSWORD=
DB_DATABASE=svc_auth

# Clés publiques des services de confiance — doivent correspondre aux
# clés privées régénérées pour la prod dans gateway.env/svc-gestion.env/
# svc-factures.env.
GATEWAY_JWT_PUBLIC_KEY=
GESTION_JWT_PUBLIC_KEY=
FACTURES_JWT_PUBLIC_KEY=
INSCRIPTION_JWT_PUBLIC_KEY=
