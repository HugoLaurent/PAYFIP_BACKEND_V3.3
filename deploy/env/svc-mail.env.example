# Copier en svc-mail.env sur le serveur (jamais commité).
# NODE_ENV, HOST, PORT, DB_HOST, DB_PORT sont fixés directement dans
# deploy/docker-compose.yml — inutile de les redéfinir ici.
#
# IMPORTANT : ne JAMAIS définir MAIL_TEST_OVERRIDE_EMAIL ici — sinon tous
# les emails réels (OTP, confirmations) partent vers une adresse de dev
# au lieu du vrai destinataire.

TZ=UTC
LOG_LEVEL=info
APP_KEY=
APP_URL=http://svc-mail:3339

# Doit correspondre exactement à SVC_MAIL_USER/PASSWORD/DB de
# deploy/postgres/.env.
DB_USER=svc_mail
DB_PASSWORD=
DB_DATABASE=svc_mail

BILLETTERIE_JWT_PUBLIC_KEY=
FACTURES_JWT_PUBLIC_KEY=
GATEWAY_JWT_PUBLIC_KEY=

# real : envoi effectif par SMTP.
MAIL_MODE=real

# Identifiants SMTP réels déjà utilisés (support@aregie.com via Outlook/
# M365) — à reprendre tels quels depuis svc-mail/.env actuel, ce ne sont
# pas des placeholders à régénérer.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
